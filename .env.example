# ============================================================
# MediCop — Variables de entorno
# Copia este archivo a .env y configura los valores reales
# NUNCA subas .env al repositorio
# ============================================================

# --- Entorno ---
ENVIRONMENT=development
# Opciones: development | staging | production

# --- Base de datos PostgreSQL ---
POSTGRES_DB=medicop
POSTGRES_USER=medicop
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql+asyncpg://medicop:CHANGE_ME@postgres:5432/medicop

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_GUIDELINES=clinical_guidelines

# --- Ollama / LLM ---
OLLAMA_BASE_URL=http://ollama:11434
# medgemma1.5:4b — Google Health AI Developer Foundations (Gemma 3 base).
# Mejora sobre medgemma:4b: razonamiento clínico de texto + interpretación de
# EHR / reportes de laboratorio. Mismo footprint VRAM (~3.3 GB Q4_K_M).
# En RTX 3060 6 GB → ~90 tok/s; en CPU → ~20 tok/s.
# Para rollback: cambiar a medgemma:4b (versión anterior estable).
OLLAMA_MODEL=medgemma1.5:4b
OLLAMA_TIMEOUT=120

# --- Seguridad ---
# SECRET_KEY: mínimo 64 caracteres aleatorios, genera con:
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_64
# ENCRYPTION_KEY: exactamente 32 bytes para AES-256
#   python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=CHANGE_ME_exactly_32_bytes_for_aes!
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Whisper ---
# small en CPU = portable a cualquier servidor hospital (sin GPU dedicada).
# Para mejor calidad con GPU, cambiar a: WHISPER_MODEL=large-v3-turbo,
# WHISPER_COMPUTE_TYPE=float16, WHISPER_DEVICE=cuda
WHISPER_MODEL=small
WHISPER_LANGUAGE=es
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- CMP (Colegio Médico del Perú) ---
# Endpoint de validación de número CMP del médico
CMP_VALIDATION_ENABLED=false
CMP_API_URL=https://cmp.org.pe/api/validate
